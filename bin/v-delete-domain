#!/bin/bash
# info: delete domain reverse proxy
# options: USER DOMAIN [RESTART]
#
# example: v-delete-domain admin example.com
#
# This function removes a domain's Nginx reverse proxy configuration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
restart=${3-yes}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain_proxy.sh
source $HESTIA/func/domain_proxy.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [RESTART]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
if [ ! -f "$USER_DATA/domain.conf" ] || ! grep -q "DOMAIN='$domain'" "$USER_DATA/domain.conf"; then
	check_result "$E_NOTEXIST" "domain $domain doesn't exist"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Remove Nginx configuration
remove_domain_config "$user" "$domain"

# Remove from domain.conf
conf="$USER_DATA/domain.conf"
sed -i "/DOMAIN='$domain'/d" "$conf"

# Test nginx config
test_nginx_config
if [ $? -ne 0 ]; then
	check_result "$E_INVALID" "Nginx configuration test failed after deletion"
fi

# Reload nginx
if [ "$restart" = 'yes' ]; then
	reload_nginx
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Decrease domain counter
decrease_user_value "$user" '$U_DOMAINS'

# Logging
$BIN/v-log-action "$user" "Info" "Domain" "Deleted domain proxy ($domain)."
log_event "$OK" "$ARGUMENTS"

exit
