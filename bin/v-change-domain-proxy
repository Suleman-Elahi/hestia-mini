#!/bin/bash
# info: change domain proxy settings
# options: USER DOMAIN TARGETS [ALGORITHM] [SSL] [RESTART]
#
# example: v-change-domain-proxy admin example.com "10.1.0.101:8080 10.1.0.102:8080 weight=2" least_conn no yes
#
# This function updates an existing domain's reverse proxy configuration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
targets=$3
algorithm=${4-round_robin}
ssl=${5-no}
restart=${6-yes}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain_proxy.sh
source $HESTIA/func/domain_proxy.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN TARGETS [ALGORITHM] [SSL] [RESTART]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
if [ ! -f "$USER_DATA/domain.conf" ] || ! grep -q "DOMAIN='$domain'" "$USER_DATA/domain.conf"; then
	check_result "$E_NOTEXIST" "domain $domain doesn't exist"
fi

# Validate algorithm
case "$algorithm" in
	round_robin|least_conn|ip_hash|hash)
		;;
	*)
		check_result "$E_INVALID" "invalid algorithm: $algorithm"
		;;
esac

# Validate SSL option
case "$ssl" in
	yes|no)
		;;
	*)
		check_result "$E_INVALID" "invalid SSL option: $ssl"
		;;
esac

# Verify target format (HOST:PORT or IP:PORT, optional weight/params)
for target in $targets; do
	if [[ ! "$target" =~ ^[a-zA-Z0-9.-]+:[0-9]+(\ +.*)?$ ]]; then
		check_result "$E_INVALID" "invalid target format: $target (must be HOST:PORT or IP:PORT)"
	fi
done

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Remove old configuration
remove_domain_config "$user" "$domain"

# Write new configuration
write_domain_config "$user" "$domain" "$algorithm" "$targets" "$ssl"

# Update domain.conf
conf="$USER_DATA/domain.conf"
sed -i "/DOMAIN='$domain'/d" "$conf"
new_timestamp
echo "DOMAIN='$domain' ALGORITHM='$algorithm' TARGETS='$targets' SSL='$ssl' SUSPENDED='no' TIME='$time' DATE='$date'" >> "$conf"
chmod 660 "$conf"

# Test nginx config
test_nginx_config
if [ $? -ne 0 ]; then
	check_result "$E_INVALID" "Nginx configuration test failed"
fi

# Reload nginx
if [ "$restart" = 'yes' ]; then
	reload_nginx
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Domain" "Changed domain proxy ($domain)."
log_event "$OK" "$ARGUMENTS"

exit
