#!/bin/bash
# info: change domain proxy settings
# options: USER DOMAIN TARGETS [ALGORITHM] [SSL] [RESTART]
#
# example: v-change-domain-proxy admin example.com "10.1.0.101:8080 10.1.0.102:8080 weight=2" weighted no yes
#
# A backend may be followed by a `weight=N' token (N >= 1) to bias load
# balancing; unweighted backends default to weight 1.
#
# This function updates an existing domain's reverse proxy configuration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
targets=$3
algorithm=${4-round_robin}
ssl=${5-no}
restart=${6-yes}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain_proxy.sh
source $HESTIA/func/domain_proxy.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN TARGETS [ALGORITHM] [SSL] [RESTART]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
if [ ! -f "$USER_DATA/domain.conf" ] || ! grep -q "DOMAIN='$domain'" "$USER_DATA/domain.conf"; then
	check_result "$E_NOTEXIST" "domain $domain doesn't exist"
fi

# Validate algorithm
case "$algorithm" in
	round_robin|weighted|least_conn|ip_hash|hash)
		;;
	*)
		check_result "$E_INVALID" "invalid algorithm: $algorithm (must be round_robin, weighted, least_conn, ip_hash, or hash)"
		;;
esac

# Validate SSL option
case "$ssl" in
	yes|no)
		;;
	*)
		check_result "$E_INVALID" "invalid SSL option: $ssl"
		;;
esac

# Verify the target list and reject malformed input early. Each backend is
# HOST:PORT (optionally http(s):// prefixed) and may be followed by a
# whitespace-separated weight=N modifier.
validate_proxy_targets "$targets"

# Preserve managed certificate state on edits. Disabling SSL explicitly removes
# only certificates which this proxy domain is known to manage.
old_record=$(grep -m1 -F "DOMAIN='$domain'" "$USER_DATA/domain.conf")
parse_object_kv_list "$old_record"
old_letsencrypt="$LETSENCRYPT"
old_fail_count="$LETSENCRYPT_FAIL_COUNT"
old_ssl="$SSL"

# Remove old configuration
remove_domain_config "$user" "$domain"

# Write new configuration
write_domain_config "$user" "$domain" "$algorithm" "$targets" "$ssl"

# Update domain.conf
conf="$USER_DATA/domain.conf"
sed -i "/DOMAIN='$domain'/d" "$conf"
new_timestamp
metadata=''
if [ "$ssl" = 'yes' ] && [ "$old_letsencrypt" = 'yes' ]; then
	metadata=" LETSENCRYPT='yes' LETSENCRYPT_FAIL_COUNT='${old_fail_count:-0}'"
fi
if [ "$ssl" = 'no' ] && [ "$old_letsencrypt" = 'yes' ]; then
	rm -f "$USER_DATA/ssl/$domain.crt" "$USER_DATA/ssl/$domain.key" \
		"$USER_DATA/ssl/$domain.pem" "$USER_DATA/ssl/$domain.ca"
fi
echo "DOMAIN='$domain' ALGORITHM='$algorithm' TARGETS='$targets' SSL='$ssl' SUSPENDED='no' TIME='$time' DATE='$date'$metadata" >> "$conf"
chmod 660 "$conf"

# A stale IP-bound default_server vhost (e.g. /etc/nginx/conf.d/<IP>.conf)
# shadows this domain and makes the reload below fail to bind the new
# wildcard listens, so drop it first (backed up under /root/).
remove_shadowing_default_vhosts

# Test nginx config
test_nginx_config
if [ $? -ne 0 ]; then
	check_result "$E_INVALID" "Nginx configuration test failed"
fi

# Reload nginx
if [ "$restart" = 'yes' ]; then
	reload_nginx
	check_result $? "Nginx reload failed"
fi

# Issue when SSL is newly enabled. Existing managed certificates are preserved
# on backend/algorithm edits and renewed by v-update-letsencrypt-ssl.
if [ "$ssl" = 'yes' ] && [ "$old_ssl" != 'yes' ]; then
	$BIN/v-add-letsencrypt-domain "$user" "$domain" '' '' proxy
	issue_status=$?
	if [ "$issue_status" -ne 0 ]; then
		# Revert only the SSL state; the requested backend changes stay applied.
		sed -i "/DOMAIN='$domain'/d" "$conf"
		new_timestamp
		echo "DOMAIN='$domain' ALGORITHM='$algorithm' TARGETS='$targets' SSL='$old_ssl' SUSPENDED='no' TIME='$time' DATE='$date'" >> "$conf"
		write_domain_config "$user" "$domain" "$algorithm" "$targets" "$old_ssl"
		test_nginx_config
		check_result $? "Nginx configuration test failed while rolling back SSL"
		reload_nginx
		check_result $? "Nginx reload failed while rolling back SSL"
		check_result "$issue_status" "Let's Encrypt SSL certificate installation failed"
	fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Domain" "Changed domain proxy ($domain)."
log_event "$OK" "$ARGUMENTS"

exit
