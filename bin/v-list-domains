#!/bin/bash
# info: list domains
# options: USER [FORMAT]
#
# example: v-list-domains admin
#
# This function lists all configured reverse proxy domains for a user.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	IFS=$'\n'
	i=1
	objects=$(grep DOMAIN $USER_DATA/domain.conf 2>/dev/null | wc -l)
	echo "{"
	if [ -f "$USER_DATA/domain.conf" ]; then
		while read str; do
			[ -z "$str" ] && continue
			parse_object_kv_list "$str"
			echo -n '    "'$DOMAIN'": {'
			echo "\"ALGORITHM\":\"$ALGORITHM\",\"TARGETS\":\"$TARGETS\",\"SSL\":\"$SSL\",\"SUSPENDED\":\"$SUSPENDED\",\"TIME\":\"$TIME\",\"DATE\":\"$DATE\"}"
			if [ "$i" -lt "$objects" ]; then
				echo ','
			else
				echo
			fi
			((i++))
		done < <(cat $USER_DATA/domain.conf)
	fi
	echo '}'
}

# SHELL list function
shell_list() {
	IFS=$'\n'
	echo "DOMAIN     ALGORITHM     SSL     SUSPENDED     DATE"
	echo "------     ---------     ---     ---------     ----"
	if [ -f "$USER_DATA/domain.conf" ]; then
		while read str; do
			[ -z "$str" ] && continue
			parse_object_kv_list "$str"
			echo "$DOMAIN $ALGORITHM $SSL $SUSPENDED $DATE"
		done < <(cat $USER_DATA/domain.conf)
	fi
}

# PLAIN list function
plain_list() {
	IFS=$'\n'
	if [ -f "$USER_DATA/domain.conf" ]; then
		while read str; do
			[ -z "$str" ] && continue
			parse_object_kv_list "$str"
			echo -e "$DOMAIN\t$ALGORITHM\t$TARGETS\t$SSL\t$SUSPENDED\t$TIME\t$DATE"
		done < <(cat $USER_DATA/domain.conf)
	fi
}

# CSV list function
csv_list() {
	IFS=$'\n'
	echo "DOMAIN,ALGORITHM,TARGETS,SSL,SUSPENDED,TIME,DATE"
	if [ -f "$USER_DATA/domain.conf" ]; then
		while read str; do
			[ -z "$str" ] && continue
			parse_object_kv_list "$str"
			echo "$DOMAIN,$ALGORITHM,\"$TARGETS\",$SSL,$SUSPENDED,$TIME,$DATE"
		done < <(cat $USER_DATA/domain.conf)
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
